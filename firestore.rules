rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validCategory(category) {
      return category in ['질문', '풀이 공유', '팁', '자유'];
    }

    function validPost(data) {
      return data.keys().hasAll(['title', 'category', 'author', 'authorUid', 'body', 'createdAt', 'likes', 'likedBy', 'comments'])
        && data.keys().hasOnly(['title', 'category', 'author', 'authorUid', 'language', 'body', 'createdAt', 'likes', 'likedBy', 'comments'])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 10000
        && data.author is string && data.author.size() >= 1 && data.author.size() <= 60
        && data.authorUid == request.auth.uid
        && (!('language' in data) || data.language in ['ko', 'ja'])
        && validCategory(data.category)
        && data.createdAt is timestamp
        && data.likes == 0
        && data.likedBy is list && data.likedBy.size() == 0
        && data.comments is list && data.comments.size() == 0;
    }

    function isOwner() {
      return signedIn() && resource.data.authorUid == request.auth.uid;
    }

    function isSafeOwnerEdit() {
      return isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'category', 'body'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 10000
        && validCategory(request.resource.data.category);
    }

    function isSafeLike() {
      let oldLikedBy = resource.data.get('likedBy', []);
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy'])
        && request.resource.data.likes == resource.data.likes + 1
        && request.resource.data.likedBy is list
        && oldLikedBy is list
        && request.resource.data.likedBy.size() == oldLikedBy.size() + 1
        && request.auth.uid in request.resource.data.likedBy
        && !(request.auth.uid in oldLikedBy);
    }

    function isSafeComment() {
      let nextComments = request.resource.data.comments;
      let nextComment = nextComments[nextComments.size() - 1];
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments'])
        && nextComments is list
        && resource.data.comments is list
        && nextComments.size() == resource.data.comments.size() + 1
        && nextComments.hasAll(resource.data.comments)
        && nextComment.keys().hasAll(['id', 'author', 'authorUid', 'body', 'createdAt'])
        && nextComment.keys().hasOnly(['id', 'author', 'authorUid', 'body', 'createdAt'])
        && nextComment.id is string
        && nextComment.id.size() >= 1
        && nextComment.id.size() <= 100
        && nextComment.authorUid == request.auth.uid
        && nextComment.author is string
        && nextComment.author.size() >= 1
        && nextComment.author.size() <= 60
        && nextComment.body is string
        && nextComment.body.size() >= 1
        && nextComment.body.size() <= 2000
        && nextComment.createdAt is string
        && nextComment.createdAt.size() <= 40;
    }

    // 커뮤니티: 읽기는 공개, 쓰기는 인증 및 작성자/변경 필드 검증
    match /community/{postId} {
      allow read: if true;
      allow create: if signedIn() && validPost(request.resource.data);
      allow update: if isSafeOwnerEdit() || isSafeLike() || isSafeComment();
      allow delete: if isOwner();
    }

    // 유저 데이터: 본인만 읽기/쓰기
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
